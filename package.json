{
  "name": "momentum-workshop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "convex dev --start 'pnpm exec next dev'",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "convex": "1.46.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3"
  }
}
